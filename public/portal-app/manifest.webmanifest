{
  "name": "SOS&A Practice Portal",
  "short_name": "SOS&A Portal",
  "description": "Segun Sipeolu & Associates staff portal",
  "id": "/portal",
  "start_url": "/portal",
  "scope": "/portal",
  "display": "standalone",
  "background_color": "#2B0D17",
  "theme_color": "#2B0D17",
  "icons": [
    { "src": "/portal-app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/portal-app/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/portal-app/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/portal/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", "image/*", "audio/*", "video/mp4", "text/plain", "text/csv", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".eml", ".msg", ".zip", ".rtf",
            "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/zip"]
        }
      ]
    }
  }
}
