# Staff portal settings. Copy to .env.local for development, or set these as
# environment variables on the host. Never commit real values.

# ── Required in production ──────────────────────────────────────
# Encrypts stored files and two-factor secrets. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# KEEP A COPY SOMEWHERE SAFE AND SEPARATE: without it, stored files cannot be read.
APP_SECRET=
# One-time code needed to create the first (Managing Partner) account.
PORTAL_SETUP_TOKEN=
# The public address of the site, used in reminder links and the Word add-in.
PORTAL_URL=https://www.segunsipeolu.com

# ── Database ────────────────────────────────────────────────────
# PostgreSQL connection string. Leave empty to use the built-in database,
# stored in PORTAL_DATA_DIR (fine for one server; not for serverless hosts).
DATABASE_URL=
# DATABASE_SSL=no-verify     # some managed databases need this
# Where the built-in database and uploaded files live (default ./data).
PORTAL_DATA_DIR=
PORTAL_MAX_FILE_MB=100

# ── Security options ────────────────────────────────────────────
# Two-factor sign-in: required for Managing Partner and partners by default.
# Set to "all" to require it for everyone.
PORTAL_REQUIRE_2FA=
# Minutes of inactivity before signing out (default 30).
PORTAL_IDLE_MINUTES=30

# ── Reminders by email (Brevo) ──────────────────────────────────
BREVO_API_KEY=
NOTIFY_FROM_EMAIL=portal@segunsipeolu.com
NOTIFY_FROM_NAME=SOS&A Portal

# ── Reminders by SMS (Termii, Nigeria) ──────────────────────────
TERMII_API_KEY=
# Sender ID approved by Termii, e.g. SOSA
TERMII_SENDER_ID=
# "dnd" reaches numbers on the Do-Not-Disturb list (transactional route)
TERMII_CHANNEL=dnd
# "full" puts matter titles in texts. Default sends only matter numbers (SMS is not private).
PORTAL_SMS_DETAIL=

# ── Daily reminders schedule ────────────────────────────────────
# A scheduler calls GET /portal/api/cron/reminders with
# "Authorization: Bearer <CRON_SECRET>" every morning (06:00 UTC = 7am Lagos).
CRON_SECRET=

# ── Meeting transcription and AI minutes ────────────────────────
# Speech-to-text (Deepgram). Check their data-processing terms first.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# AI minutes (Claude, by Anthropic).
ANTHROPIC_API_KEY=

# ── Mailbox in the portal ──────────────────────────────────────
# The firm's mail servers, so staff only type their address and password.
# (cPanel hosting: usually mail.<domain>, IMAP 993, SMTP 465.)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465

# ── Email to the portal ────────────────────────────────────────
# A mailbox (e.g. portal@segunsipeolu.com) the portal empties into staff
# inboxes. Call /portal/api/cron/mail-intake every 5-15 minutes with the
# CRON_SECRET. Only verified staff senders (SPF/DKIM pass) are accepted.
PORTAL_INTAKE_ADDRESS=portal@segunsipeolu.com
PORTAL_INTAKE_IMAP_HOST=
PORTAL_INTAKE_IMAP_PORT=993
PORTAL_INTAKE_USER=
PORTAL_INTAKE_PASSWORD=
